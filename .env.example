# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=            # Claude - plans, reviews, translates, writes cards
ELEVENLABS_API_KEY=           # brand voiceover (optional: without it videos use silent preview narration)

# Optional
STUDIO_SECURE_COOKIES=1       # 1 when served over HTTPS (recommended in production)
STUDIO_MAX_PARALLEL_JOBS=1    # videos rendered at the same time (each wants ~4 CPU cores)
STUDIO_MAX_UPLOAD_MB=4000
# STUDIO_ADMIN_EMAIL= / STUDIO_ADMIN_PASSWORD=   # create the admin automatically instead of the first-visit setup page
